{
  "schema_version": "eve.exact-head-validation-reuse-ledger.v1",
  "policy": {
    "purpose": "Prevent duplicate full-suite and compatibility validation across chat, PR-metadata, and operator-session changes.",
    "reuse_required_when": [
      "the exact validated code head is unchanged",
      "the exact artifact exists and its SHA-256 matches",
      "the validation workflow scope and pinned compatibility dependency are unchanged",
      "the prerequisite PR is merged and its merge SHA is present in the current ancestry"
    ],
    "non_invalidating_changes": [
      "chat or operator session change",
      "PR body or title edit",
      "PR comment or review metadata change",
      "Draft or Ready transition",
      "reporting-only reuse of an already pinned prerequisite"
    ],
    "invalidators": [
      "code-head change affecting the validated tree",
      "artifact loss, expiry without retained immutable copy, or corruption",
      "artifact SHA-256 mismatch",
      "validation workflow or test-scope change",
      "pinned compatibility dependency change",
      "base ancestry no longer contains the recorded merge SHA"
    ],
    "discovery_rule": "A new implementation PR runs compile, focused tests, M0 invariance, and M2-B validation before forward registration. Full-suite is blocked until exact fingerprints are registered. Full-suite runs once on the final registered head.",
    "registration_only_rule": "Intermediate registration-only heads are not evidence. Workflow concurrency should cancel superseded runs; only the final registered exact head may be accepted.",
    "manual_rerun_rule": "Do not manually rerun a green pinned prerequisite merely because work moved to another chat or PR. Record the reused entry in the new PR instead.",
    "new_chat_handoff_rule": "At the start of every new chat or operator session, inspect this ledger first. When the latest prerequisite entry still satisfies reuse_required_when, reuse it and do not schedule its full-suite or M2-E validation again."
  },
